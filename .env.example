# PostgreSQL (InsForge) - server-side only
# Copy to .env and fill with real values from your InsForge dashboard.
# IMPORTANT: Keep this file private. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-INSFORGE-HOST:5432/insforge?sslmode=require
INSFORGE_API_KEY=YOUR_INSFORGE_API_KEY
JWT_SECRET=YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_SECRET=YOUR_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PORT=3000
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional local overrides (used only if DATABASE_URL is not set)
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
