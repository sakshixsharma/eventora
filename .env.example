# App
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5000

# Security
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CSRF_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PGSSLMODE=require

# Seeding (used only by db/seed.js, never commit real value)
SEED_PASSWORD=replace-with-a-strong-seed-password

# Optional InsForge key placeholder (only if your deployment uses InsForge APIs)
INSFORGE_API_KEY=
